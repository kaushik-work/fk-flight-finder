# Copy to .env on the droplet at /opt/fk-flight-finder/.env

# FlightKlub backend that stores the fares.
API_BASE=https://flightklub.com

# Must match FARE_INGEST_SECRET in flight-klub-website (.env.local AND Vercel).
FARE_INGEST_SECRET=

# Optional. Empty means scrape direct from the droplet IP, which is verified
# working — see README. Set a comma-separated list only if CAPTCHAs appear.
PROXY_URLS=

# Tuning. Defaults are in scrape.py; SCRAPE_NIGHTS must match the frontend cap.
# SCRAPE_MONTHS=4
# SCRAPE_NIGHTS=5
# SCRAPE_DAYS=15,28
# SCRAPE_DELAY=5
